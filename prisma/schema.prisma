// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String        @id @default(uuid()) @db.Uuid
  email               String        @unique
  name                String
  avatar              String?
  settings            Setting[]
  categories          Category[]
  projects            Project[]
  fields              Field[]
  files               File[]
  currencies          Currency[]
  transactions        Transaction[]
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")
  stripeCustomerId    String?       @map("stripe_customer_id")
  membershipPlan      String?       @map("membership_plan")
  membershipExpiresAt DateTime?     @map("membership_expires_at")
  emailVerified       Boolean       @default(false) @map("is_email_verified")
  storageUsed         Int           @default(0) @map("storage_used")
  storageLimit        Int           @default(-1) @map("storage_limit")
  aiBalance           Int           @default(0) @map("ai_balance")
  businessName        String?       @map("business_name")
  businessAddress     String?       @map("business_address")
  businessBankDetails String?       @map("business_bank_details")
  businessLogo        String?       @map("business_logo")
  accounts            Account[]
  sessions            Session[]
  appData             AppData[]
  progress            Progress[]
  bankAccounts        FinTSBankAccount[]
  auditLogs           AuditLog[]
  recurringInvoices   RecurringInvoice[]
  companyProfile      CompanyProfile?
  fixedAssets          FixedAsset[]
  bookingSessions      BookingSession[]
  manualBookingEntries ManualBookingEntry[]
  openItems            OpenItem[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  token     String
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@map("account")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("verification")
}

model Setting {
  id          String  @id @default(uuid()) @db.Uuid
  userId      String  @map("user_id") @db.Uuid
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  code        String
  name        String
  description String?
  value       String?

  @@unique([userId, code])
  @@map("settings")
}

model Category {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  code         String
  name         String
  color        String        @default("#000000")
  llm_prompt   String?
  transactions Transaction[]
  createdAt    DateTime      @default(now()) @map("created_at")

  @@unique([userId, code])
  @@map("categories")
}

model Project {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  code         String
  name         String
  color        String        @default("#000000")
  llm_prompt   String?
  transactions Transaction[]
  createdAt    DateTime      @default(now()) @map("created_at")

  @@unique([userId, code])
  @@map("projects")
}

model Field {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @map("user_id") @db.Uuid
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code                String
  name                String
  type                String   @default("string")
  llm_prompt          String?
  options             Json?
  createdAt           DateTime @default(now()) @map("created_at")
  isVisibleInList     Boolean  @default(false) @map("is_visible_in_list")
  isVisibleInAnalysis Boolean  @default(false) @map("is_visible_in_analysis")
  isRequired          Boolean  @default(false) @map("is_required")
  isExtra             Boolean  @default(true) @map("is_extra")

  @@unique([userId, code])
  @@map("fields")
}

model File {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  filename          String
  path              String
  mimetype          String
  metadata          Json?
  isReviewed        Boolean  @default(false) @map("is_reviewed")
  isSplitted        Boolean  @default(false) @map("is_splitted")
  cachedParseResult Json?    @map("cached_parse_result")
  createdAt         DateTime @default(now()) @map("created_at")

  @@map("files")
}

model Transaction {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                  String?
  description           String?
  merchant              String?
  total                 Int?
  currencyCode          String?   @map("currency_code")
  convertedTotal        Int?      @map("converted_total")
  convertedCurrencyCode String?   @map("converted_currency_code")
  type                  String?   @default("expense")
  items                 Json      @default("[]")
  note                  String?
  files                 Json      @default("[]")
  extra                 Json?
  category              Category? @relation(fields: [categoryCode, userId], references: [code, userId])
  categoryCode          String?   @map("category_code")
  project               Project?  @relation(fields: [projectCode, userId], references: [code, userId])
  projectCode           String?   @map("project_code")
  issuedAt              DateTime? @map("issued_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  text                  String?
  sourceType            String?   @default("manual") @map("source_type")
  externalId            String?   @map("external_id")
  bankAccountId         String?   @map("bank_account_id") @db.Uuid
  bankAccount           FinTSBankAccount? @relation(fields: [bankAccountId], references: [id])
  isReconciled          Boolean   @default(false) @map("is_reconciled")
  reconciledAt          DateTime? @map("reconciled_at")

  // GoBD compliance fields
  isLocked              Boolean   @default(false) @map("is_locked")
  lockedAt              DateTime? @map("locked_at")
  bookingNumber         Int?      @default(autoincrement()) @map("booking_number")
  reversalOfId          String?   @unique @map("reversal_of_id") @db.Uuid
  reversedById          String?   @unique @map("reversed_by_id") @db.Uuid
  reversalOf            Transaction?  @relation("ReversalOf", fields: [reversalOfId], references: [id])
  reversedBy            Transaction?  @relation("ReversedBy", fields: [reversedById], references: [id])
  reversalOfInverse     Transaction?  @relation("ReversalOf")
  reversedByInverse     Transaction?  @relation("ReversedBy")

  @@index([userId])
  @@index([projectCode])
  @@index([categoryCode])
  @@index([issuedAt])
  @@index([name])
  @@index([merchant])
  @@index([total])
  @@index([externalId])
  @@index([bankAccountId])
  @@index([isLocked])
  @@index([bookingNumber])
  @@map("transactions")
}

model FinTSBankAccount {
  id                String        @id @default(uuid()) @db.Uuid
  userId            String        @map("user_id") @db.Uuid
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankCode          String        @map("bank_code")
  bankName          String?       @map("bank_name")
  accountNumber     String        @map("account_number")
  iban              String?
  bic               String?
  fintsUrl          String        @map("fints_url")
  fintsUser         String        @map("fints_user")
  fintsPin          String        @map("fints_pin")
  bankingInfo       Json?         @map("banking_info")
  tanMethodId       Int?          @map("tan_method_id")
  tanMediaName      String?       @map("tan_media_name")
  lastSyncAt        DateTime?     @map("last_sync_at")
  lastSyncStatus    String?       @map("last_sync_status")
  isActive          Boolean       @default(true) @map("is_active")
  transactions      Transaction[]
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  @@unique([userId, iban])
  @@index([userId])
  @@map("fints_bank_accounts")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  target    String?
  details   Json?
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model Currency {
  id     String  @id @default(uuid()) @db.Uuid
  userId String? @map("user_id") @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  code   String
  name   String

  @@unique([userId, code])
  @@map("currencies")
}

model AppData {
  id     String @id @default(uuid()) @db.Uuid
  app    String
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  data   Json

  @@unique([userId, app])
  @@map("app_data")
}

model Progress {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  data      Json?
  current   Int      @default(0)
  total     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("progress")
}

model RecurringInvoice {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  merchant          String?
  description       String?
  amount            Int
  currencyCode      String    @default("EUR") @map("currency_code")
  type              String    @default("expense")
  categoryCode      String?   @map("category_code")
  projectCode       String?   @map("project_code")
  frequency         String    @default("monthly")
  startDate         DateTime  @map("start_date") @db.Date
  endDate           DateTime? @map("end_date") @db.Date
  nextDueDate       DateTime  @map("next_due_date") @db.Date
  lastGeneratedAt   DateTime? @map("last_generated_at")
  isActive          Boolean   @default(true) @map("is_active")
  autoGenerate      Boolean   @default(false) @map("auto_generate")
  notifyBeforeDays  Int?      @default(3) @map("notify_before_days")
  inflationAdjusted Boolean   @default(false) @map("inflation_adjusted")
  baseAmount        Int?      @map("base_amount")
  baseYear          Int?      @map("base_year")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([userId])
  @@index([nextDueDate])
  @@index([isActive])
  @@map("recurring_invoices")
}

model CompanyProfile {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String   @unique @map("user_id") @db.Uuid
  companyName         String?  @map("company_name")
  legalForm           String?  @map("legal_form")
  street              String?
  zipCode             String?  @map("zip_code")
  city                String?
  taxNumber           String?  @map("tax_number")
  vatId               String?  @map("vat_id")
  taxOffice           String?  @map("tax_office")
  fiscalYearStart     String?  @default("01-01") @map("fiscal_year_start")
  phone               String?
  email               String?
  website             String?
  chartOfAccounts     String?  @default("SKR04") @map("chart_of_accounts")
  datevConsultant     String?  @map("datev_consultant")
  datevClient         String?  @map("datev_client")
  erpnextUrl          String?  @map("erpnext_url")
  erpnextApiKey       String?  @map("erpnext_api_key")
  erpnextApiSecret    String?  @map("erpnext_api_secret")
  sageExportEnabled   Boolean  @default(false) @map("sage_export_enabled")
  telegramBotToken    String?  @map("telegram_bot_token")
  telegramChatId      String?  @map("telegram_chat_id")
  onboardingCompleted Boolean  @default(false) @map("onboarding_completed")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("company_profiles")
}

model FixedAsset {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String   @map("user_id") @db.Uuid
  name                 String
  description          String?
  inventoryNumber      String?  @map("inventory_number")
  category             String   // bueromoebel, computer, software, pkw, etc.
  acquisitionDate      DateTime @map("acquisition_date") @db.Date
  acquisitionCost      Int      @map("acquisition_cost") // cents
  residualValue        Int      @default(0) @map("residual_value")
  usefulLifeYears      Int      @map("useful_life_years")
  depreciationMethod   String   @default("linear") @map("depreciation_method") // linear, degressive, gwg, sammelposten
  isActive             Boolean  @default(true) @map("is_active")
  disposalDate         DateTime? @map("disposal_date") @db.Date
  disposalProceeds     Int?     @map("disposal_proceeds")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  user                 User     @relation(fields: [userId], references: [id])

  @@map("fixed_assets")
}

model BookingSession {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  name          String   // e.g. "Buchungssitzung März 2026 - Woche 1"
  description   String?
  periodMonth   Int      @map("period_month") // 1-12
  periodYear    Int      @map("period_year")
  status        String   @default("open") // open, reviewed, locked
  lockedAt      DateTime? @map("locked_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  user          User     @relation(fields: [userId], references: [id])
  entries       ManualBookingEntry[]

  @@map("booking_sessions")
}

model ManualBookingEntry {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId         String   @map("session_id") @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  bookingDate       DateTime @map("booking_date") @db.Date
  receiptNumber     String?  @map("receipt_number") // Belegnummer
  receiptDate       DateTime? @map("receipt_date") @db.Date // Belegdatum
  description       String   // Buchungstext
  debitAccount      String   @map("debit_account") // Sollkonto (SKR04)
  creditAccount     String   @map("credit_account") // Habenkonto (SKR04)
  amount            Int      // Betrag in Cent
  taxRate           Decimal? @map("tax_rate") @db.Decimal(5,2) // 19.00, 7.00, 0.00
  taxAmount         Int?     @map("tax_amount") // USt-Betrag in Cent
  costCenter        String?  @map("cost_center") // Kostenstelle
  merchant          String?
  notes             String?
  isTemplate        Boolean  @default(false) @map("is_template") // Buchungsvorlage
  templateName      String?  @map("template_name")
  transactionId     String?  @map("transaction_id") @db.Uuid // Link to Transaction if posted
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  session           BookingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id])

  @@map("manual_booking_entries")
}

model OpenItem {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  type            String    // debitor, kreditor
  invoiceNumber   String    @map("invoice_number")
  invoiceDate     DateTime  @map("invoice_date") @db.Date
  dueDate         DateTime  @map("due_date") @db.Date
  merchant        String
  merchantAddress String?   @map("merchant_address")
  amount          Int       // cents
  paidAmount      Int       @default(0) @map("paid_amount")
  status          String    @default("open") // open, partial, paid, overdue, dunned
  dunningLevel    Int       @default(0) @map("dunning_level")
  lastDunningDate DateTime? @map("last_dunning_date")
  dunningFees     Int       @default(0) @map("dunning_fees") // accumulated fees in cents
  interestAccrued Int       @default(0) @map("interest_accrued") // accumulated interest in cents
  transactionId   String?   @map("transaction_id") @db.Uuid
  notes           String?
  isB2B           Boolean   @default(true) @map("is_b2b")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  user            User      @relation(fields: [userId], references: [id])
  dunningHistory  DunningEntry[]

  @@index([userId])
  @@index([status])
  @@index([dueDate])
  @@map("open_items")
}

model DunningEntry {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  openItemId  String   @map("open_item_id") @db.Uuid
  level       Int      // 1, 2, 3
  date        DateTime @db.Date
  fee         Int      // cents
  interest    Int      // cents
  letterText  String?  @map("letter_text")
  sentVia     String?  @map("sent_via") // email, post, telegram
  createdAt   DateTime @default(now()) @map("created_at")
  openItem    OpenItem @relation(fields: [openItemId], references: [id], onDelete: Cascade)

  @@index([openItemId])
  @@map("dunning_entries")
}
